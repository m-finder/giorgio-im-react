{
  "name": "@m-finder/giorgio-im-react",
  "version": "0.2.0",
  "description": "A drop-in React instant messaging widget",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-finder/giorgio-im-react.git"
  },
  "type": "module",
  "files": ["dist"],
  "main": "./dist/giorgio-im-react.umd.cjs",
  "module": "./dist/giorgio-im-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/giorgio-im-react.js",
      "require": "./dist/giorgio-im-react.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vue/compiler-dom": "^3.5.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^2.1.0"
  }
}
